// Worker-side compiler options; the Start browser tree is checked separately.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types/experimental", "node"],
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "paths": {
      "#app/*": ["./src/app/*"],
      "#client/*": ["./client/*"],
      "#universal/*": ["./universal/*"],
      "#worker/*": ["./src/*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "universal/**/*.ts", "universal/**/*.tsx"]
}
